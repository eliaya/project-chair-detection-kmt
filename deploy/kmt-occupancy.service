# Installed by scripts/install_pi.sh (@ROOT@ / @USER@ are filled in there).
[Unit]
Description=Table occupancy monitor (main.py)
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
User=@USER@
SupplementaryGroups=video
WorkingDirectory=@ROOT@
# API_TOKEN and CONFIG_URL
EnvironmentFile=/etc/kmt-occupancy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@ROOT@/.venv/bin/python main.py --config ${CONFIG_URL}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
