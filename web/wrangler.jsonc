{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kmt-occupancy",
  "main": "./worker/index.ts",
  // Matches the installed workerd; bump together with `npm i -D wrangler@latest`.
  "compatibility_date": "2026-10-12",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kmt-occupancy",
      // Fill in with the id printed by `npx wrangler d1 create kmt-occupancy` (see README).
      "migrations_dir": "migrations"
    }
  ],
  // Live camera view relay (worker/live.ts), one object per device
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRelay"] }],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
